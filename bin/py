#!/usr/bin/env bash
# py [args...] — run python in a container, against this directory's .venv.
#
#   py                  REPL
#   py script.py        run a script
#   py -m pytest        any python -m ...
#
# The .venv lives in the project directory and persists, which is the point:
# `py -m pip install requests` once, and every later `py` in this directory has
# it. The container is thrown away; the environment is not.
#
# Version comes from .python-version if present, else 3.12.

set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/run.sh"

version="$(dr_setting .python-version .python.version 2>/dev/null || echo "${PYTHON_VERSION:-3.12}")"
image="python:${version}-slim"

# requirements.txt is installed only when the venv is first created. Doing it on
# every run would add a pip resolve to the start of every single command; if you
# change requirements, `py -m pip install -r requirements.txt` is the explicit
# way to pick it up, and `rm -rf .venv` is the sledgehammer.
# Quoted heredoc: $PWD and $PATH must be expanded by the shell INSIDE the
# container, not by this one. Unquoted, PATH would be the Mac's.
read -r -d '' tail_script <<'SCRIPT' || true
exec .venv/bin/python "$@"
SCRIPT

script="$(dr_venv_prep)
$tail_script"

dr_exec "$image" "$script" "$@"
